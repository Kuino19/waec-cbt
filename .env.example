# =========================================================
# WAEC CBT PLATFORM — Environment Variables
# Copy this file to .env.local and fill in your values
# =========================================================

# ---- Neon PostgreSQL (https://neon.tech) ----
# Create a project at neon.tech and paste your connection string here
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/waec_cbt?sslmode=require"

# ---- App URL ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Paystack (https://paystack.com) ----
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Termii SMS (https://termii.com) ----
TERMII_API_KEY="your_termii_api_key_here"
TERMII_SENDER_ID="EduCBT"

# ---- JWT Secret (generate with: openssl rand -hex 32) ----
JWT_SECRET="change_this_to_a_random_secret_string"

# ---- Phase 2+: AI Features ----
# GOOGLE_AI_API_KEY="your_gemini_api_key"
# GOOGLE_CLOUD_VISION_KEY="your_vision_api_key"
